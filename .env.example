# ============ 企业微信 ============
# 企业 ID（管理后台 → 我的企业 → 企业信息；旧名 WECHAT_CORPID 仍兼容）
WECHAT_CORP_ID=wwxxxxxxxxxxxxxxxx
# 自建应用 ID（管理后台 → 应用管理 → 你的应用 → AgentId）
WECHAT_AGENT_ID=1000002
# 应用 Secret（管理后台 → 应用 → 查看 Secret）
WECHAT_SECRET=your_app_secret
# 回调验证 Token（应用 → 接收消息 → Token，约 25 位随机串，勿与 AESKey 混淆）
WECHAT_TOKEN=your_callback_token
# 回调消息加解密 AES Key（应用 → 接收消息 → EncodingAESKey，固定 43 位 base64，无等号）
WECHAT_ENCODING_AES_KEY=your_43_char_base64_key_without_padding
# （可选）企微 API 请求前缀：默认官方域名 https://qyapi.weixin.qq.com。
# 若触发 errcode 60020（IP 不在白名单），可改为指向固定 IP 反代的地址：
# WECHAT_API_BASE_URL=https://qyapi.weixin.qq.com

# ============ Figma ============
# Figma 个人访问令牌（Figma → Settings → Security → Personal access tokens）
FIGMA_ACCESS_TOKEN=figd_xxxxxxxxxxxx
# （可选）Figma API 代理 Base URL：指向 VPS 独立 IP 反代可破除 IP 级频控，默认官方域名
# FIGMA_API_BASE_URL=https://api.figma.com

# ============ 视觉大模型（OpenRouter 或 OpenAI 兼容端点）============
# 方式一：OpenRouter（推荐）。配置后自动使用 https://openrouter.ai/api/v1 作为 Base URL
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
# LLM_MODEL 必须选择「支持图片输入」的视觉模型，推荐：
#   google/gemini-2.0-flash-001（也支持 qwen-2.5-vl、meta-llama/llama-3.2-11b-vision 等）
LLM_MODEL=google/gemini-2.0-flash-001
# 方式二：自建 OpenAI 兼容端点（与 OpenRouter 二选一），再配置以下两项：
# LLM_API_KEY=sk-xxxxxxxx
# LLM_BASE_URL=https://api.example.com/v1
# LLM_MODEL=your-vision-model-name